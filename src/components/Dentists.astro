---
const dentists = [
  { name: 'Muniraj B', qualification: 'BDS', experience: '30+ years of experience', photo: '/images/muniraj-b-photo.jpeg', alt: 'Dr. Muniraj B, BDS', width: 791, height: 1024 },
  { name: 'Hemalatha J', qualification: 'BDS', experience: '30+ years of experience', photo: '/images/hemalatha-j-photo.jpeg', alt: 'Dr. Hemalatha J, BDS', width: 960, height: 1280 },
];
---

<section id="dentists" class="dentists" aria-labelledby="dentists-title">
  <div class="container">
    <div class="dentists__intro">
      <div>
        <p class="eyebrow"><span aria-hidden="true"></span> THE PEOPLE BEHIND THE CARE</p>
        <h2 id="dentists-title">Meet our <em>dentists.</em></h2>
      </div>
      <p>Our clinic communicates in Tamil, English, Hindi and Telugu.</p>
    </div>
    <div class="dentists__grid">
      {dentists.map((dentist) => (
        <article class="dentist-card">
          <div class="dentist-card__photo">
            <img src={dentist.photo} alt={dentist.alt} width={dentist.width} height={dentist.height} loading="lazy" decoding="async" />
          </div>
          <div class="dentist-card__details">
            <div>
              <h3>{dentist.name}</h3>
              <p>{dentist.qualification}</p>
              <p class="dentist-card__experience">{dentist.experience}</p>
            </div>
            <span aria-hidden="true">✳</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .dentists { padding-block: clamp(5rem, 9vw, 9rem); background: var(--color-white); }
  .dentists__intro { display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  h2 { margin-top: 1.25rem; font-size: clamp(3rem, 5vw, 5rem); line-height: 1.05; letter-spacing: -0.04em; }
  h2 em { color: var(--color-forest); }
  .dentists__intro > p { max-width: 22rem; color: #59635a; font-size: 0.95rem; line-height: 1.8; }
  .dentists__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 3.5rem; }
  .dentist-card__photo { width: 100%; min-height: 17rem; aspect-ratio: 1.5 / 1; overflow: hidden; background: #edf2e9; }
  .dentist-card:nth-child(2) .dentist-card__photo { background: #f1eee6; }
  .dentist-card__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 12%; }
  .dentist-card__details { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 0; border-bottom: 1px solid #dce5d7; }
  h3 { font-size: 1.7rem; }
  .dentist-card__details p { margin-top: 0.25rem; color: var(--color-forest); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; }
  .dentist-card__details .dentist-card__experience { color: #59635a; font-weight: 400; letter-spacing: normal; }
  .dentist-card__details > span { color: var(--color-beige); }
  @media (max-width: 700px) {
    .dentists__intro { align-items: start; flex-direction: column; }
    .dentists__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
