---
const links = [
  { label: 'Home', href: '#home' },
  { label: 'About', href: '#about' },
  { label: 'Treatments', href: '#treatments' },
  { label: 'Our Dentists', href: '#dentists' },
  { label: 'Gallery', href: '#gallery' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#home" aria-label="Sudharsan Dental Clinic, home">
      <span class="brand__name">SUDHARSAN</span>
      <span class="brand__descriptor">DENTAL CLINIC <span aria-hidden="true">·</span> EST. 1994</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <a class="button button--primary header-cta" href="#appointment">
      Request an Appointment <span aria-hidden="true">↗</span>
    </a>

    <details class="mobile-menu">
      <summary aria-label="Toggle navigation menu">
        <span></span><span></span><span></span>
      </summary>
      <nav class="mobile-nav" aria-label="Mobile navigation">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a class="button button--primary" href="#appointment">Request an Appointment <span aria-hidden="true">↗</span></a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) {
      menu.open = false;
    }
  });
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    background: rgba(247, 245, 239, 0.97);
    border-bottom: 1px solid rgba(83, 107, 81, 0.12);
  }
  .header-inner {
    min-height: 6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand { display: flex; flex: none; flex-direction: column; gap: 0.15rem; }
  .brand__name { font-family: var(--font-heading); font-size: 1.25rem; letter-spacing: 0.08em; line-height: 1; }
  .brand__descriptor { color: var(--color-forest); font-size: 0.51rem; font-weight: 700; letter-spacing: 0.15em; }
  .brand__descriptor span { color: var(--color-beige); }
  .desktop-nav { display: flex; align-items: center; gap: clamp(1rem, 2vw, 2rem); }
  .desktop-nav a { font-size: 0.74rem; font-weight: 600; white-space: nowrap; }
  .desktop-nav a:hover, .mobile-nav a:not(.button):hover { color: var(--color-forest); }
  .header-cta { min-height: 3rem; padding-inline: 1.1rem; white-space: nowrap; }
  .mobile-menu { display: none; }
  @media (max-width: 1100px) {
    .desktop-nav, .header-cta { display: none; }
    .header-inner { min-height: 5rem; }
    .mobile-menu { display: block; }
    .mobile-menu summary {
      display: flex;
      width: 2.75rem;
      height: 2.75rem;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      border: 1px solid #cbd4c8;
      cursor: pointer;
      list-style: none;
    }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu summary span { width: 1.1rem; height: 1px; background: var(--color-charcoal); }
    .mobile-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0.75rem var(--page-gutter) 1.5rem;
      background: var(--color-ivory);
      border-bottom: 1px solid #d5ddd1;
      box-shadow: 0 16px 25px rgba(48, 54, 48, 0.08);
    }
    .mobile-nav a:not(.button) { padding: 0.8rem 0; font-size: 0.9rem; font-weight: 600; }
    .mobile-nav .button { margin-top: 0.75rem; align-self: flex-start; }
  }
</style>
